{
  "name": "aura-fint",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "lint": "prettier \"*/**/*.{ts,tsx}\" --check",
    "lint:fix": "prettier \"*/**/*.{ts,tsx}\" --write",
    "test": "pnpm run test:e2e",
    "test:e2e": "esbuild tests/factoring.ts --bundle --platform=node --format=cjs --outfile=tests/dist/factoring.cjs --external:mocha --external:chai --log-level=warning && mocha --timeout 120000 tests/dist/factoring.cjs",
    "seed": "esbuild sdk/scripts/seed-localnet.mts --bundle --platform=node --format=cjs --outfile=sdk/dist/seed.cjs --log-level=warning && node sdk/dist/seed.cjs",
    "idl": "node scripts/gen-idl.mjs"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1"
  },
  "devDependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "esbuild": "^0.28.2",
    "mocha": "^9.0.3",
    "prettier": "^3.0.0",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.3.3"
  }
}
