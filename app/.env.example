# Aura Fint — env vars (todo es público, las keys NUNCA van con NEXT_PUBLIC_)
#
# Vercel: Settings → Environment Variables (Production).
# El programa aún no está en devnet: deployarlo con scripts/devnet-deploy.sh
# y después `RPC_URL=https://api.devnet.solana.com pnpm seed` para poblar
# el marketplace con las mismas 6 facturas del demo.

# RPC del cluster. En producción conviene una API key gratis de Helius/QuickNode:
# el endpoint público de devnet rate-limita el timeline (historial por factura).
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# USDC usado por el protocolo. En devnet es el mint mock del seed
# (determinístico: sale de deploy-keys/usdc-mint.json). En mainnet sería el
# USDC real de Circle.
NEXT_PUBLIC_USDC_MINT=EAm8az1fRMrtRE75nKmph9pWP3Gs8oTf4FdURhi95DG3

# Wallets del demo (para que el SeedPanel y las cards sepan quién es quién).
# Son las pubkey de deploy-keys/deployer.json y deploy-keys/demo-investor.json.
NEXT_PUBLIC_DEMO_ISSUER=4isZ1mVhHX2f7RDqcG7oYyZctQ9rdSatTzTrDB5udYr3
NEXT_PUBLIC_DEMO_INVESTOR=99UtkySks4Ap7obNxhePyLnH4z99vkn22NusgUkUseK1

# "0" oculta el panel de herramientas del demo en producción.
NEXT_PUBLIC_DEMO_TOOLS=0
